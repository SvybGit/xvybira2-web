<button class="flex min-h-fit w-fit flex-row items-center rounded-2xl bg-white/20 transition duration-100 ease-in-out hover:scale-105 hover:cursor-pointer active:scale-105">
	@if (Url != null) {
		<a href="@Url" class="scale-100 text-white">
			@ChildContent
		</a>
	} else
	{
		@ChildContent
	}
</button>

@code {
	[Parameter]
	public RenderFragment? ChildContent { get; set; }

	[Parameter] 
    public string? Url { get; set; }
}