
<div class="absolute inset-x-1/12 top-0 z-30 min-w-fit rounded-lg border-4 border-red-500 bg-(--primary-dark) p-4 text-center text-2xl transition duration-200 ease-out md:inset-x-1/3 @(_visible? VisibleClass : HiddenClass)">
	@_text
</div>


@code {
	private const string HiddenClass = "opacity-0 -translate-y-full";
	private const string VisibleClass = "opacity-100 translate-y-0";
	private string _text = "";
	private bool _visible = false;

	public async Task Show(string text, int delayMs)
	{
		_text = text;
		_visible = true;
		StateHasChanged();

		await Task.Delay(delayMs);

		_visible = false;
		StateHasChanged();
	}
}
