<TailwindAnimateOnScroll InnerClass="size-full" InAnimationClass="animate-fade-up animate-duration-1000 animate-ease-out animate-normal">
	<HoverCard Url="@Url" Class="size-full">
		<div class="flex min-h-36 flex-col items-center gap-3 px-6 py-3 text-left">
			<h2 class="mb-0 w-full self-start border-b-2 border-(--icon-color)">@Title</h2>
			@ChildContent
		</div>
	</HoverCard>
</TailwindAnimateOnScroll>

@code {

	[Parameter] public required string Title { get; set; }

	[Parameter] public string? Url { get; set; }

	[Parameter] public RenderFragment? ChildContent { get; set; }
}
