<div class="@Class fixed end-0 z-40 h-full w-full bg-(--primary-dark) outline-2 outline-(--icon-color) transition-transform duration-200 ease-out sm:w-96">
    <div class="flex size-full flex-col justify-center gap-6 bg-white/20 text-center sm:pl-10 sm:text-left">
        @ChildContent
    </div>
</div>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public string? Class { get; set; }

    public NavMenu() {
        Class = "";
    }

    public NavMenu(string @class) {
        Class = @class;
    }

}
