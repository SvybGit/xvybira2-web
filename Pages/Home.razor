@page "/"
@using xvybira2_web.Components.Resume
<div class="flex flex-col lg:flex-row">
	<Pofile/>
	<div class="bg-size-[600%] bg-linear-60 from-indigo-800 from-30%% to-(--icon-color) transition-all lg:w-1 xl:w-16 2xl:w-36"></div>
	<div class="w-full px-6 lg:px-12">
		<h1>About me</h1>
		<div class="max-w-2xl rounded-2xl bg-white/20 p-6">
			<p>
				A third-year Bachelor's student in Computer Science at the Faculty of Informatics, Masaryk University.
			</p>
			<p>💻 I enjoy programming in object-oriented languages such as Java or C#.</p>
			<p>💬I am fluent in both English and Czech.</p>
			<p>🎓I am always open to new learning opportunities and eager to learn even more about programming and computer science.</p>
			<p>🚀 I quickly adapt to new technologies and environments, and I enjoy working in passionate teams that care about their work.</p>
			<p>In my free time, I like producing electronic music 🎵 and I especially enjoy sound design ☺️.</p>
		</div>
		<h1>Skill set</h1>
		<ul class="max-w-2xl list-inside list-disc rounded-2xl bg-white/20 p-6">
			<li>Programming: Java, C#, Python</li>
			<li>Web: HTML CSS, Tailwind, Blazor</li>
			<li>Databases: SQL, Oracle, PL/SQL</li>
			<li>Tools: Git, GitHub, GiLab, Node.js, JetBrains IDEs, Visual Studio, VS Code</li>
		</ul>
		<h1>Education</h1>
		<div class="flex max-w-2xl flex-col justify-evenly gap-4">
			<HoverCard Url="https://www.fi.muni.cz/admission/bc/informatics.html.en">
				<PictureText ImgSrc="./Images/FI-MU-logo.png">
					<div class="text-left">
						<h1 class="text-left">Faculty of Informatics, Masaryk University.</h1>
					</div>
				</PictureText>
			</HoverCard>
			<HoverCard Url="https://www.gymhol.cz/">
				<PictureText ImgSrc="./Images/gymhol.png">
					<div class="text-left">
						<h1 class="text-left">Gymnázium Ladislava Jaroše</h1>
					</div>
				</PictureText>
			</HoverCard>
		</div>
		<h1>Projects</h1>
		<div class="mb-14 w-full">
			<div class="flex w-full max-w-2xl flex-col gap-4">
				<ProjectShowcaseCard Url="https://github.com/SvybGit/xvybira2-web" Title="This website">
					<p>
						This project is built using the ASP.NET Core Blazor framework.
						For styling, I am using the tailwind v4 CSS framework.
						This website is hosted on an Apache webserver provided by our university.
					</p>
					<div class="flex flex-row gap-3">
						<Image Class="h-12" Src="./Images/blazor-logo.png"></Image>
						<Image Class="h-12" Src="./Images/c-sharp-logo.png"></Image>
						<Image Class="h-12" Src="./Images/tailwind-logo.png"></Image>
					</div>
				</ProjectShowcaseCard>
				<ProjectShowcaseCard Url="https://github.com/SvybGit/git-like-db" Title="Git-like versioning system database">
					<p>
						An Oracle database school project script that simulates basic actions in a versioning system similar to Git
					</p>
					<div class="flex h-12 flex-row gap-3">
						<Image Class="h-12" Src="./Images/oracle-db-logo.png"></Image>
						<Image Class="h-12" Src="./Images/git-logo.png"></Image>
						<Image Class="h-12" Src="./Images/pl-sql-logo.png"></Image>
					</div>
				</ProjectShowcaseCard>
				<ProjectShowcaseCard Title="Todo app" Url="https://github.com/SvybGit/xvybira2-web/tree/5582342a5233e595e41f1f7aed596bb518f50045/Components/TodoApp">
					<p>
						Made to get more familiar with the blazor framework and learn CRUD operations.
					</p>
					<div class="flex h-12 flex-row gap-3">
						<Image Class="h-12" Src="./Images/todo-logo.png"></Image>
						<Image Class="h-12" Src="./Images/c-sharp-logo.png"></Image>
					</div>
				</ProjectShowcaseCard>
			</div>
		</div>
	</div>
</div>